# HTTP port the API listens on
PORT=3001

# development | production | test
NODE_ENV=development

# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Base URL of the Python ML microservice
ML_BASE_URL=http://localhost:8000

# Shared secret sent as X-API-Key to the ML service (leave empty if the ML service has no key)
ML_API_KEY=

# Per-call timeout for ML requests, in milliseconds
ML_TIMEOUT_MS=2000

# JSON file used for persistence (created automatically)
DATA_FILE=./data/reports.json